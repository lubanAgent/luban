.PHONY: check check-example

check:
	@unformatted="$$(gofmt -l $$(find . -name '*.go' -type f))"; \
	if [ -n "$$unformatted" ]; then \
		printf '%s\n' "Unformatted Go files:" "$$unformatted" >&2; \
		exit 1; \
	fi
	go mod tidy -diff
	go test ./...
	go test -race ./...
	go vet ./...
	go build -trimpath ./...

check-example:
	cd integrations/example && go mod tidy -diff
	cd integrations/example && go test ./...
	cd integrations/example && go test -race ./...
	cd integrations/example && go vet ./...
	cd integrations/example && go build -trimpath ./...
